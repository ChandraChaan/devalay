# Copy to .env for local development. Never commit real values.
DEVALAY_ENV=development
DEVALAY_DATABASE_URL=postgresql+psycopg://devalay:devalay@localhost:5432/devalay
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
DEVALAY_SECRET_KEY=change-me
DEVALAY_PUBLIC_BASE_URL=http://localhost:8000
DEVALAY_CONTACT_EMAIL=privacy@example.com
DEVALAY_CORS_ORIGINS=["*"]

# Media: "local" (served from /media) or "r2"
DEVALAY_STORAGE_BACKEND=local
DEVALAY_R2_ACCOUNT_ID=
DEVALAY_R2_ACCESS_KEY_ID=
DEVALAY_R2_SECRET_ACCESS_KEY=
DEVALAY_R2_BUCKET=
DEVALAY_R2_PUBLIC_BASE_URL=

# Optional AI (Claude). Leave empty to use the free offline generators.
DEVALAY_ANTHROPIC_API_KEY=
DEVALAY_ANTHROPIC_MODEL=claude-opus-5-5
DEVALAY_AI_FREE_DAILY_LIMIT=5

# Google Play subscription verification (service account JSON or its base64)
DEVALAY_GOOGLE_PLAY_PACKAGE=com.chandrachaan.devalay
DEVALAY_GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
DEVALAY_PREMIUM_DEV_GRANT=false

# Optional SMTP for password reset codes
DEVALAY_SMTP_HOST=
DEVALAY_SMTP_PORT=587
DEVALAY_SMTP_USER=
DEVALAY_SMTP_PASSWORD=
DEVALAY_SMTP_FROM=Devalay <no-reply@example.com>
