<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><color android:color="#3E0E05" /></item>
    <!-- A drawable item, not <bitmap>: from Android 8 ic_launcher is an adaptive icon, which a
         <bitmap> cannot load ("requires a valid 'src' attribute"). -->
    <item android:width="96dp" android:height="96dp" android:gravity="center" android:drawable="@mipmap/ic_launcher" />
</layer-list>
