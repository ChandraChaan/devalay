<?xml version="1.0" encoding="utf-8"?>
<!-- The running Choghadiya, or Rahu Kalam while it is on. The android:text values are the gallery preview. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/now_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background_dusk"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/now_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:text="Choghadiya now"
        android:textColor="#CCFFFFFF"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/now_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Amrit · Best"
        android:textColor="#FFA5F2B5"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/now_until"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:text="until 3:12 PM"
        android:textColor="#E6FFFFFF"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/now_rahu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Rahu Kalam: 10:44 AM – 12:05 PM"
        android:textColor="#FFFFC857"
        android:textSize="12sp" />
</LinearLayout>
