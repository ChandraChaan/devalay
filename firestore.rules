rules_version = '2';

// Devalay usage statistics and feedback. Every install signs in anonymously; only the owner's
// admin account (custom claim `admin`, or an `admins/{uid}` record that no client can write)
// can read across installs. See docs/ADMIN.md.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.token.get('admin', false) == true ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function shortString(v, max) {
      return v is string && v.size() <= max;
    }

    // One summary per install, written only by that install.
    function installShape() {
      let d = request.resource.data;
      return d.keys().hasOnly(['firstSeen', 'lastSeen', 'lang', 'v', 'build', 'state', 'src', 'sessions', 'f',
          'dev', 'os', 'ram', 'cc', 't', 'np', 'na', 'nw', 'profile'])
        && d.lastSeen == request.time
        && (!('lang' in d) || shortString(d.lang, 8))
        && (!('v' in d) || shortString(d.v, 16))
        && (!('build' in d) || d.build is int)
        && (!('state' in d) || shortString(d.state, 40))
        && (!('src' in d) || shortString(d.src, 60))
        && (!('sessions' in d) || d.sessions is int)
        && (!('f' in d) || (d.f is map && d.f.size() <= 120))
        // 1.5.7+: phone model, Android API level, RAM in MB, city chosen, push token, morning Panchang
        // (on/off/blocked), notifications allowed, home-screen widgets.
        && (!('dev' in d) || shortString(d.dev, 40))
        && (!('os' in d) || d.os is int)
        && (!('ram' in d) || d.ram is int)
        && (!('cc' in d) || d.cc is bool)
        && (!('t' in d) || shortString(d.t, 400))
        && (!('np' in d) || d.np in ['on', 'off', 'blocked'])
        && (!('na' in d) || d.na is bool)
        && (!('nw' in d) || d.nw is int)
        // 1.5.11+: "About you", only while the user shares usage statistics (the city, never coordinates).
        && (!('profile' in d) || installProfile(d.profile));
    }

    function smallIndex(m, key, max) {
      return !(key in m) || (m[key] is int && m[key] >= 0 && m[key] <= max);
    }

    function installProfile(p) {
      return p is map
        && p.keys().hasOnly(['n', 'g', 'dob', 'tob', 'ag', 'r', 's', 'l', 'bp', 'go'])
        && (!('n' in p) || shortString(p.n, 40))
        && (!('g' in p) || p.g in ['m', 'f', 'o'])
        && (!('dob' in p) || (p.dob is string && p.dob.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')))
        && (!('tob' in p) || (p.tob is int && p.tob >= 0 && p.tob < 1440))
        && (!('ag' in p) || p.ag in ['under18', '18-24', '25-34', '35-44', '45-54', '55-64', '65+'])
        && smallIndex(p, 'r', 11)
        && smallIndex(p, 's', 26)
        && smallIndex(p, 'l', 11)
        && (!('bp' in p) || shortString(p.bp, 60))
        && (!('go' in p) || shortString(p.go, 40));
    }

    // The Google backup of "About you" (core/account.dart): the whole profile, readable and writable by
    // its owner only. Not even the admin screen reads it.
    function backupShape() {
      let d = request.resource.data;
      let p = d.p;
      return d.keys().hasOnly(['p', 'updated'])
        && d.updated == request.time
        && p is map
        && p.keys().hasOnly(['name', 'gender', 'dob', 'tob', 'placeId', 'place', 'lat', 'lon', 'tz', 'gotra',
            'rashi', 'nakshatra', 'pada', 'lagna', 'byHand'])
        && (!('name' in p) || shortString(p.name, 60))
        && (!('gender' in p) || p.gender in ['male', 'female', 'other'])
        && (!('dob' in p) || (p.dob is string && p.dob.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')))
        && (!('tob' in p) || (p.tob is int && p.tob >= 0 && p.tob < 1440))
        && (!('placeId' in p) || shortString(p.placeId, 60))
        && (!('place' in p) || shortString(p.place, 80))
        && (!('lat' in p) || p.lat is number)
        && (!('lon' in p) || p.lon is number)
        && (!('tz' in p) || shortString(p.tz, 60))
        && (!('gotra' in p) || shortString(p.gotra, 40))
        && smallIndex(p, 'rashi', 11)
        && smallIndex(p, 'nakshatra', 26)
        && (!('pada' in p) || (p.pada is int && p.pada >= 1 && p.pada <= 4))
        && smallIndex(p, 'lagna', 11)
        && (!('byHand' in p) || p.byHand is bool);
    }

    // The member's own summary of their chat thread: either a message they just sent, or marking
    // the owner's replies as read.
    function memberThread() {
      let d = request.resource.data;
      return d.keys().hasOnly(['uid', 'lang', 'v', 'premium', 'updated', 'last', 'lastFrom', 'unreadAdmin', 'unreadUser'])
        && d.get('uid', request.auth.uid) == request.auth.uid
        && (
          (d.lastFrom == 'user' && d.last is string && d.last.size() <= 120 && d.updated == request.time
            && d.unreadUser == 0 && d.unreadAdmin is int)
          || (resource != null && d.diff(resource.data).affectedKeys().hasOnly(['unreadUser']) && d.unreadUser == 0)
        );
    }

    match /installs/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create: if signedIn() && request.auth.uid == uid && installShape()
        && request.resource.data.get('firstSeen', request.time) == request.time;
      // firstSeen is written once, as the server time, and never changed afterwards.
      allow update: if signedIn() && request.auth.uid == uid && installShape()
        && (
          !('firstSeen' in resource.data)
            ? request.resource.data.get('firstSeen', request.time) == request.time
            : request.resource.data.firstSeen == resource.data.firstSeen
        );
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
    }

    match /profiles/{uid} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid && backupShape();
    }

    // A batch of actions (at most one write a minute per install).
    match /events/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'at', 'sid', 'items'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.at == request.time
        && shortString(request.resource.data.sid, 20)
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 60;
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update: if false;
    }

    // Feedback: users add notes, only the admin reads them or marks them done.
    match /feedback/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'at', 'kind', 'text', 'lang', 'v', 'done'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.at == request.time
        && request.resource.data.kind in ['idea', 'problem', 'praise']
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && shortString(request.resource.data.lang, 8)
        && shortString(request.resource.data.v, 16)
        && request.resource.data.done == false;
      allow read, delete: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['done', 'status', 'note']);
    }

    // Premium support chat: one thread per install. The member writes as 'user', the owner's admin
    // screen as 'admin'; each side can only add messages in its own role. Messages are never edited.
    match /support/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create, update: if isAdmin() || (signedIn() && request.auth.uid == uid && memberThread());
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid);

      match /messages/{id} {
        allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
        allow create: if request.resource.data.keys().hasOnly(['from', 'text', 'at'])
          && request.resource.data.at == request.time
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000
          && ((signedIn() && request.auth.uid == uid && request.resource.data.from == 'user')
            || (isAdmin() && request.resource.data.from == 'admin'));
        allow update: if false;
        allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
      }
    }

    // Pushes sent from the admin screen. Written only by the sendPush Cloud Function (Admin SDK);
    // an install that opens one adds 1 to its open count and can change nothing else.
    match /campaigns/{id} {
      allow read: if isAdmin();
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['opens'])
        && request.resource.data.opens == resource.data.get('opens', 0) + 1;
      allow create, delete: if false;
    }

    // Who is an admin. Created only in the Firebase console or with the Admin SDK.
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
